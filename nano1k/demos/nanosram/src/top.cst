IO_LOC "cs_pin" 20; 
IO_PORT "cs_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP  BANK_VCCIO=3.3;
IO_LOC "sio[0]" 28; 
IO_PORT "sio[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP  BANK_VCCIO=3.3;
IO_LOC "sio[1]" 31; 
