ADDR   BYTES          LINE   SOURCE
----------------------------------------------------------------------
00                    1      .ORG 0
00                    2      main:
00     58 1F          3          LDi R2,operands     ; R2 = pointer to operands
02     83 08          4          JALR mult           ; call multiply routine
04     54 21          5          LDi R1,product      ; R1 = pointer to where to store product
06     71             6          ST  R0,R1           ; store product
07     F0             7          HALT
                      8      
                      9      ; mult(p) R2 => [operands], product => R0
08                    10     mult:
08     50 1E          11         LDi R0,multtemp
0A     7C             12         ST  R3,R0           ; save return address
0B     62             13         LD  R0,R2           ; R0 = Multiplier (A)
0C     98             14         INC R2
0D     66             15         LD  R1,R2           ; R1 = Multiplicand (B)
0E     2F             16         XOR R3,R3           ; R3 = Accumulator (zero it out)
                      17     
0F                    18     mult_loop:              ; Multiply R0 by R1 => R3
0F     F2             19         LSB R0              ; ZF = LSB of R0
10     81 13          20         JZ  skip_add        ; If LSB was 0, skip adding Multiplicand
12     0D             21         ADD R3,R1           ; Accumulator += Multiplicand
13                    22     skip_add:
13     92             23         SHR R0              ; Multiplier >>= 1
14     81 19          24         JZ  mult_done       ; Exit loop if R0 is zero
16     05             25         ADD R1,R1           ; Multiplicand <<= 1
17     80 0F          26         JMP mult_loop
                      27     
19                    28     mult_done:
19     A3             29         MOV R0,R3           ; R0 = R3
1A     5C 1E          30         LDi R3,multtemp
1C     6F             31         LD  R3,R3           ; restore return address (LDi/LD using same reg is handy for not destroying a pointless reg)
1D     B0             32         RET
1E                    33     multtemp:
1E     00             34     .DB 0
                      35     
1F                    36     operands:
1F     07 06          37     .DB 7, 6                ; Inputs: 7, 6. Output placeholder: 0
21                    38     product:
21     00             39     .DB 0                   ; Output placeholder: 0

