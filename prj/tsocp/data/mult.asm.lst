SYMBOL TABLE:
----------------------------------------------------------------------
main                     : 0x00 (0)
mult                     : 0x08 (8)
mult_done                : 0x19 (25)
mult_loop                : 0x0F (15)
multtemp                 : 0x1E (30)
operands                 : 0x1F (31)
product                  : 0x21 (33)
skip_add                 : 0x13 (19)
