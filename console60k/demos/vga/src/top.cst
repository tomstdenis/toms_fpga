IO_PORT "vga_r[1]" IO_TYPE=LVCMOS33  DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "vga_r[0]" V18;
IO_PORT "vga_r[0]" IO_TYPE=LVCMOS33  DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "vga_v_pulse" B22;
IO_PORT "vga_v_pulse" IO_TYPE=LVCMOS33  DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "vga_h_pulse" E18;
IO_PORT "vga_h_pulse" IO_TYPE=LVCMOS33  DRIVE=8 BANK_VCCIO=3.3;
