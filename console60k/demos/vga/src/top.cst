IO_LOC "clk" V22;
IO_PORT "clk" PULL_MODE=NONE IO_TYPE=LVCMOS33;

// onboard PMOD next to USB type A port
// TOP: VCC GND C22 F18 G21 V18
// BOT: VCC GND B22 E18 G22 V19
