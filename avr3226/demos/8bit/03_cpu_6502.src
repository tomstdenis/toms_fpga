	/* 0xA6 */ { CPU_6502_OP_LDX, CPU_6502_ZP, 3 },
	/* 0xA7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xA8 */ { CPU_6502_OP_TAY, CPU_6502_IMP, 2 },
	/* 0xA9 */ { CPU_6502_OP_LDA, CPU_6502_IMM, 2 },
	/* 0xAA */ { CPU_6502_OP_TAX, CPU_6502_IMP, 2 },
	/* 0xAB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xAC */ { CPU_6502_OP_LDY, CPU_6502_ABS, 4 },
	/* 0xAD */ { CPU_6502_OP_LDA, CPU_6502_ABS, 4 },
	/* 0xAE */ { CPU_6502_OP_LDX, CPU_6502_ABS, 4 },
	/* 0xAF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },

	/* 0xB0 */ { CPU_6502_OP_BCS, CPU_6502_IMM, 2 },
	/* 0xB1 */ { CPU_6502_OP_LDA, CPU_6502_IND_Y, 5 },
	/* 0xB2 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xB3 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xB4 */ { CPU_6502_OP_LDY, CPU_6502_ZP_X, 4 },
	/* 0xB5 */ { CPU_6502_OP_LDA, CPU_6502_ZP_X, 4 },
	/* 0xB6 */ { CPU_6502_OP_LDX, CPU_6502_ZP_Y, 4 },
	/* 0xB7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xB8 */ { CPU_6502_OP_CLV, CPU_6502_IMP, 2 },
	/* 0xB9 */ { CPU_6502_OP_LDA, CPU_6502_ABS_Y, 4 },
	/* 0xBA */ { CPU_6502_OP_TSX, CPU_6502_IMP, 2 },
	/* 0xBB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xBC */ { CPU_6502_OP_LDY, CPU_6502_ABS_X, 4 },
	/* 0xBD */ { CPU_6502_OP_LDA, CPU_6502_ABS_X, 4 },
	/* 0xBE */ { CPU_6502_OP_LDX, CPU_6502_ABS_Y, 4 },
	/* 0xBF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },

	/* 0xC0 */ { CPU_6502_OP_CPY, CPU_6502_IMM, 2 },
	/* 0xC1 */ { CPU_6502_OP_CMP, CPU_6502_IND_X, 6 },
	/* 0xC2 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xC3 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xC4 */ { CPU_6502_OP_CPY, CPU_6502_ZP, 3 },
	/* 0xC5 */ { CPU_6502_OP_CMP, CPU_6502_ZP, 3 },
	/* 0xC6 */ { CPU_6502_OP_DEC, CPU_6502_ZP, 5 },
	/* 0xC7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xC8 */ { CPU_6502_OP_INY, CPU_6502_IMP, 2 },
	/* 0xC9 */ { CPU_6502_OP_CMP, CPU_6502_IMM, 2 },
	/* 0xCA */ { CPU_6502_OP_DEX, CPU_6502_IMP, 2 },
	/* 0xCB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xCC */ { CPU_6502_OP_CPY, CPU_6502_ABS, 4 },
	/* 0xCD */ { CPU_6502_OP_CMP, CPU_6502_ABS, 4 },
	/* 0xCE */ { CPU_6502_OP_DEC, CPU_6502_ABS, 6 },
	/* 0xCF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },

	/* 0xD0 */ { CPU_6502_OP_BNE, CPU_6502_IMM, 2 },
	/* 0xD1 */ { CPU_6502_OP_CMP, CPU_6502_IND_Y, 5 },
	/* 0xD2 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xD3 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xD4 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xD5 */ { CPU_6502_OP_CMP, CPU_6502_ZP_X, 4 },
	/* 0xD6 */ { CPU_6502_OP_DEC, CPU_6502_ZP_X, 6 },
	/* 0xD7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xD8 */ { CPU_6502_OP_CLD, CPU_6502_IMP, 2 },
	/* 0xD9 */ { CPU_6502_OP_CMP, CPU_6502_ABS_Y, 4 },
	/* 0xDA */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xDB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xDC */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xDD */ { CPU_6502_OP_CMP, CPU_6502_ABS_X, 4 },
	/* 0xDE */ { CPU_6502_OP_DEC, CPU_6502_ABS_X, 7 },
	/* 0xDF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },

	/* 0xE0 */ { CPU_6502_OP_CPX, CPU_6502_IMM, 2 },
	/* 0xE1 */ { CPU_6502_OP_SBC, CPU_6502_IND_X, 6 },
	/* 0xE2 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xE3 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xE4 */ { CPU_6502_OP_CPX, CPU_6502_ZP, 3 },
	/* 0xE5 */ { CPU_6502_OP_SBC, CPU_6502_ZP, 3 },
	/* 0xE6 */ { CPU_6502_OP_INC, CPU_6502_ZP, 5 },
	/* 0xE7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xE8 */ { CPU_6502_OP_INX, CPU_6502_IMP, 2 },
	/* 0xE9 */ { CPU_6502_OP_SBC, CPU_6502_IMM, 2 },
	/* 0xEA */ { CPU_6502_OP_NOP, CPU_6502_IMP, 2 },
	/* 0xEB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xEC */ { CPU_6502_OP_CPX, CPU_6502_ABS, 4 },
	/* 0xED */ { CPU_6502_OP_SBC, CPU_6502_ABS, 4 },
	/* 0xEE */ { CPU_6502_OP_INC, CPU_6502_ABS, 6 },
	/* 0xEF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },

	/* 0xF0 */ { CPU_6502_OP_BEQ, CPU_6502_IMM, 2 },
	/* 0xF1 */ { CPU_6502_OP_SBC, CPU_6502_IND_Y, 5 },
	/* 0xF2 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xF3 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xF4 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xF5 */ { CPU_6502_OP_SBC, CPU_6502_ZP_X, 4 },
	/* 0xF6 */ { CPU_6502_OP_INC, CPU_6502_ZP_X, 6 },
	/* 0xF7 */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xF8 */ { CPU_6502_OP_SED, CPU_6502_IMP, 2 },
	/* 0xF9 */ { CPU_6502_OP_SBC, CPU_6502_ABS_Y, 4 },
	/* 0xFA */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xFB */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xFC */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
	/* 0xFD */ { CPU_6502_OP_SBC, CPU_6502_ABS_X, 4 },
	/* 0xFE */ { CPU_6502_OP_INC, CPU_6502_ABS_X, 7 },
	/* 0xFF */ { CPU_6502_OP_NOT_IMP, CPU_6502_IMP, 2 },
};

void step_6502(uint16_t steps)
{
	uint16_t
		res, X, Y,
		addr;
	uint8_t
		val1, val2,
		opcode;

	while (steps--) {
	// handle interrupts
		if (cpu6502.ints & CPU_SIG_NMI) {
			cpu6502.ints &= ~CPU_SIG_NMI;
			// push PC
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regPC >> 8);
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regPC & 0xFF);
			// push SR
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regSR);
			cpu6502.regPC = cache_read_word(0xFFFA);
		} else if (cpu6502.ints & CPU_SIG_RESET) {
			cpu6502.ints &= ~CPU_SIG_RESET;
			cpu6502.regPC = cache_read_word(0xFFFC);
		} else if ((cpu6502.ints & CPU_SIG_IRQ) && !(cpu6502.regSR & FLAGS_I)) {
			cpu6502.ints &= ~CPU_SIG_IRQ;
			// push PC
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regPC >> 8);
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regPC & 0xFF);
			// push SR
				cache_write_byte(0x100 + (cpu6502.regSP--), cpu6502.regSR);
			cpu6502.regPC = cache_read_word(0xFFFE);
		}

		opcode = cache_read_byte(cpu6502.regPC++); // read the current opcode byte

	#ifdef TRACE
		trace_6502();
	#endif
		LOG("step_6502: (%04x) => %02x\n", cpu6502.regPC-1, opcode);

		// TODO:
			// Using opcode map figure out which operand type this opcode is
				// you need to fill in val1, and possibly val2, and possibly addr
				// You must detect store (STA/STX/STY) instructions and not FETCH anything just produce addr
			// Switch based on the OP this is


		// TODO: drop this code
		// val1 is usually A...
		val1 = cpu6502.regA;

		switch (opcode) {
			// ADC opcodes
			case 0x69: // ADC #oper
				val2 = cache_read_byte(cpu6502.regPC++);
				do_adc(val1, val2);
				COUNT(2);
				break;
			case 0x65: // ADC $zp
				val2 = cache_read_byte(cache_read_byte(cpu6502.regPC++));
				do_adc(val1, val2);
				COUNT(3);
				break;
			case 0x75: // ADC zp,X
				val2 = cache_read_byte((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF);
				do_adc(val1, val2);
				COUNT(4);
				break;
			case 0x6D: // ADC $oper
				val2 = cache_read_byte(cache_read_word(cpu6502.regPC));
				cpu6502.regPC += 2;
				do_adc(val1, val2);
				COUNT(4);
				break;
			case 0x7D: // ADC $oper,X
				val2 = cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regX);
				cpu6502.regPC += 2;
				do_adc(val1, val2);
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0x79: // ADC $oper,Y
				val2 = cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regY);
				cpu6502.regPC += 2;
				do_adc(val1, val2);
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0x61: // ADC ($oper,X)
				val2 = cache_read_byte(cache_read_word((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF));
				do_adc(val1, val2);
				COUNT(6);
				break;
			case 0x71: // ADC ($oper),Y
				val2 = cache_read_byte(X = (Y = cache_read_word(cache_read_byte(cpu6502.regPC++))) + cpu6502.regY);
				do_adc(val1, val2);
				if ((X ^ Y) & 0xFF00) {
					COUNT(6);
				} else {
					COUNT(5);
				}
				break;

			// AND opcodes
			case 0x29: // AND #oper
				update_NZ(cpu6502.regA &= cache_read_byte(cpu6502.regPC++));
				COUNT(2);
				break;
			case 0x25: // AND $zp
				update_NZ(cpu6502.regA &= cache_read_byte(cache_read_byte(cpu6502.regPC++)));
				COUNT(3);
				break;
			case 0x35: // AND zp,X
				update_NZ(cpu6502.regA &= cache_read_byte((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF));
				COUNT(4);
				break;
			case 0x2D: // AND $oper
				update_NZ(cpu6502.regA &= cache_read_byte(cache_read_word(cpu6502.regPC)));
				cpu6502.regPC += 2;
				COUNT(4);
				break;
			case 0x3D: // AND $oper,X
				update_NZ(cpu6502.regA &= cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regX));
				cpu6502.regPC += 2;
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0x39: // AND $oper,Y
				update_NZ(cpu6502.regA &= cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regY));
				cpu6502.regPC += 2;
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0x21: // AND ($oper,X)
				update_NZ(cpu6502.regA &= cache_read_byte(cache_read_word((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF)));
				COUNT(6);
				break;
			case 0x31: // AND ($oper),Y
				update_NZ(cpu6502.regA &= cache_read_byte(X = (Y = cache_read_word(cache_read_byte(cpu6502.regPC++))) + cpu6502.regY));
				if ((X ^ Y) & 0xFF00) {
					COUNT(6);
				} else {
					COUNT(5);
				}
				break;

			// ASL opcodes
			case 0x0A: // ASL A
				res = (uint16_t)cpu6502.regA << 1;
				cpu6502.regA = res;
				update_NZC(res);
				COUNT(2);
				break;
			case 0x06: // ASL $zp
				res = (uint16_t)cache_read_byte(addr = cache_read_byte(cpu6502.regPC++)) << 1;
				cache_write_byte(addr, res);
				update_NZC(res);
				COUNT(5);
				break;
			case 0x16: // ASL zp,X
				res = (uint16_t)cache_read_byte(addr = ((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF)) << 1;
				cache_write_byte(addr, res);
				update_NZC(res);
				COUNT(6);
				break;
			case 0x0E: // ASL $oper
				res = (uint16_t)cache_read_byte(addr = cache_read_word(cpu6502.regPC)) << 1;
				cache_write_byte(addr, res);
				update_NZC(res);
				cpu6502.regPC += 2;
				COUNT(6);
				break;
			case 0x1E: // ASL $oper,X
				res = (uint16_t)cache_read_byte(addr = cache_read_word(cpu6502.regPC) + cpu6502.regX) << 1;
				cache_write_byte(addr, res);
				update_NZC(res);
				cpu6502.regPC += 2;
				COUNT(7);
				break;

			case 0x24: // BIT $zp
				val1 = cache_read_byte(cache_read_byte(cpu6502.regPC++));
				COUNT(3);
				goto BIT_val;
			case 0x2C: // BIT $oper
				val1 = cache_read_byte(cache_read_word(cpu6502.regPC));
				cpu6502.regPC += 2;
				COUNT(4);
	BIT_val:
				cpu6502.regSR &= ~(FLAGS_N | FLAGS_V | FLAGS_Z);
				cpu6502.regSR |= (cpu6502.regA & val1) ? 0 : FLAGS_Z;
				cpu6502.regSR |= val1 & (0x80 | 0x40);
				break;

			case 0x00: // BRK
				addr = cpu6502.regPC + 2;
				cache_write_byte(0x100 + (cpu6502.regSP-- & 0xFF), (addr  >> 8) & 0xFF);
				cache_write_byte(0x100 + (cpu6502.regSP-- & 0xFF), addr & 0xFF);
				// 2. Push SR with Break flag set
				cache_write_byte(0x100 + (cpu6502.regSP-- & 0xFF), cpu6502.regSR | FLAGS_B);
				// 3. Set Interrupt disable and Jump to IRQ/BRK vector
				cpu6502.regSR |= FLAGS_I;
				cpu6502.regPC = cache_read_word(0xFFFE);
				COUNT(7);
				break;

			// branches
			case 0x90: // BCC
				if (!(cpu6502.regSR & FLAGS_C)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0xB0: // BCS
				if ((cpu6502.regSR & FLAGS_C)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0xF0: // BEQ
				if ((cpu6502.regSR & FLAGS_Z)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0x30: // BMI
				if ((cpu6502.regSR & FLAGS_N)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0xD0: // BNE
				if (!(cpu6502.regSR & FLAGS_Z)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0x10: // BPL
				if (!(cpu6502.regSR & FLAGS_N)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0x50: // BVC
				if (!(cpu6502.regSR & FLAGS_V)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;
			case 0x70: // BVS
				if ((cpu6502.regSR & FLAGS_V)) {
					addr = (uint16_t)(cache_read_byte(cpu6502.regPC++) ^ 0x80) - 0x80; // sign extend 'relative'
					res = cpu6502.regPC;
					cpu6502.regPC += addr;
					if ((res ^ cpu6502.regPC) & 0xFF00) {
						COUNT(4);
					} else {
						COUNT(3);
					}
				} else {
					++cpu6502.regPC;
					COUNT(2);
				}
				break;

			case 0x18: // CLC
				cpu6502.regSR &= ~FLAGS_C;
				COUNT(2);
				break;
			case 0xD8: // CLD
				cpu6502.regSR &= ~FLAGS_D;
				COUNT(2);
				break;
			case 0x58: // CLI
				cpu6502.regSR &= ~FLAGS_I;
				COUNT(2);
				break;
			case 0xB8: // CLV
				cpu6502.regSR &= ~FLAGS_V;
				COUNT(2);
				break;

			// CMP opcodes
			case 0xC9: //CMP #oper
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(cpu6502.regPC++));
				COUNT(2);
				break;
			case 0xC5: //CMP $zp
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(cache_read_byte(cpu6502.regPC++)));
				COUNT(3);
				break;
			case 0xD5: //CMP zp,X
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF));
				COUNT(4);
				break;
			case 0xCD: //CMP $oper
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(cache_read_word(cpu6502.regPC)));
				cpu6502.regPC += 2;
				COUNT(4);
				break;
			case 0xDD: //CMP $oper,X
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regX));
				cpu6502.regPC += 2;
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0xD9: //CMP $oper,Y
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(X = (Y = cache_read_word(cpu6502.regPC)) + cpu6502.regY));
				cpu6502.regPC += 2;
				if ((X ^ Y) & 0xFF00) {
					COUNT(5);
				} else {
					COUNT(4);
				}
				break;
			case 0xC1: // CMP ($oper,X)
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(cache_read_word((cache_read_byte(cpu6502.regPC++) + cpu6502.regX) & 0xFF)));
				COUNT(6);
				break;
			case 0xD1: // CMP ($oper),Y
				update_NZC2((uint16_t)cpu6502.regA - cache_read_byte(X = (Y = cache_read_word(cache_read_byte(cpu6502.regPC++))) + cpu6502.regY));
