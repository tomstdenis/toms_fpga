#if defined(TRACE) && defined(HOSTPC)
#include <ncurses.h>
#define LOG(...) fprintf(stderr, __VA_ARGS__) 
#else
#define LOG(...)
#endif

// Max number of remaps (basically how many banks do you want to be able to swap)
#define MAX_REMAPS 8

// table of remaps that map anything inside a region to a new offset (offset = target_addr - start)
static struct {
	uint32_t start, end, offset;
} mem_remaps[MAX_REMAPS];

// remap a range to another base address.  This will form the basis of bank switching in the future
// map to a target of 0 to remove this entry (null entries are where start == end == 0)
void mem_remap(uint32_t start, uint32_t end, uint32_t target)
{
	uint8_t x;
	// are we updating an existing mapping
	for (x = 0; x < MAX_REMAPS; x++) {
		if (mem_remaps[x].start == start && mem_remaps[x].end == end) {
store:
			if (target != 0) {
				// update the offset of this mapping, the start/end are set when it's first create below
				mem_remaps[x].offset = target - start;
			} else {
				// we're deleting this mapping so shift the array up and clear the last.
				for (; x < (MAX_REMAPS-1); x++) {
					mem_remaps[x] = mem_remaps[x+1];
					if (!mem_remaps[x].end) {
						// we hit the end of the list so we don't need to move any more
						break;
					}
				}
				mem_remaps[MAX_REMAPS-1].start = mem_remaps[MAX_REMAPS-1].end = 0;
			}
			return;
		}
	}
	for (x = 0; x< MAX_REMAPS; x++) {
		if (mem_remaps[x].end == 0) {
			// new entry so store the start/end
			mem_remaps[x].start = start;
			mem_remaps[x].end   = end;
			goto store;
		}
	}
}

// translate an address based on current mappings or return identity function if not found
uint32_t mem_translate(uint32_t addr)
{
	uint8_t x;
	for (x = 0; x < MAX_REMAPS && mem_remaps[x].end; x++) {
		if (addr >= mem_remaps[x].start && addr <= mem_remaps[x].end) {
			return addr + mem_remaps[x].offset;
		}
	}
	return addr;
}

// memcpy but for this memory
void mem_memcpy(uint32_t src, uint32_t dst, uint16_t len)
{
	uint8_t buf[8];
	while (len) {
		uint16_t blklen = (len > sizeof(buf)) ? sizeof(buf) : len;
		mem_read_block(src, blklen, buf);
		mem_write_block(dst, blklen, buf);
		src += blklen;
		dst += blklen;
		len -= blklen;
	}
}

#ifdef HOSTPC

static uint8_t mem[512UL*1024UL]; // 512KiB

int mem_init(void)
{
	memset(mem, 0, sizeof mem);
	memset(mem_remaps, 0, sizeof mem_remaps);
	return 0;
}

void mem_read_block(uint32_t addr, uint16_t len, uint8_t *dst)
{
	LOG("mem_read_block: %04x %04x\n", addr, len);
	memcpy(dst, &mem[mem_translate(addr)], len);
}

void mem_write_block(uint32_t addr, uint16_t len, uint8_t *src)
{
	LOG("mem_write_block: %04x %04x\n", addr, len);
	memcpy(&mem[mem_translate(addr)], src, len);
}


uint8_t mem_read_byte(uint32_t addr)
{
	LOG("mem_read_byte: %04x\n", addr);
	return mem[mem_translate(addr)];
}

uint16_t mem_read_word(uint32_t addr)
{
	uint32_t ta = mem_translate(addr);
	LOG("mem_read_word: %04x\n", addr);
	return ((uint16_t)mem[ta+1] << 8) | mem[ta];
}

void mem_write_byte(uint32_t addr, uint8_t val)
{
	LOG("mem_write_byte: %04x %02x\n", addr, val);
	mem[mem_translate(addr)] = val;
}

void mem_write_word(uint32_t addr, uint16_t val)
{
	uint32_t ta = mem_translate(addr);
	LOG("mem_write_byte: %04x %04x\n", addr, val);
	mem[ta] = val&0xFF;
	mem[ta+1] = val>>8;
}

#else

// driver for 1MBit SPI SRAM

#include <SPI.h>

// spi memory code
// start a SPI transaction
void spi_mem_start_trans(int cs_pin)
{
  digitalWrite(cs_pin, LOW);
  SPI.beginTransaction(SPISettings(10000000, MSBFIRST, SPI_MODE0)); // adjust clock speed per your SRAM specs
}

void spi_mem_end_trans(int cs_pin)
{
  SPI.endTransaction();
  digitalWrite(cs_pin, HIGH);
}

// start a memory command
void spi_mem_start_cmd(int cs_pin, uint32_t address, uint8_t cmd)
{
  spi_mem_start_trans(cs_pin);
  SPI.transfer(cmd);
  SPI.transfer((address>>16)&0xFF);
  SPI.transfer((address>>8)&0xFF);
  SPI.transfer(address&0xFF);
}

// send single byte command
void spi_mem_single_pulse(int cs_pin, uint8_t cmd)
{
  spi_mem_start_trans(cs_pin);
  SPI.transfer(cmd); // WREN write enable
  spi_mem_end_trans(cs_pin);
}

// send a single byte command and return the next byte read
uint8_t spi_mem_single_cmd(int cs_pin, uint8_t cmd)
{
  uint8_t res;
  spi_mem_start_trans(cs_pin);
  SPI.transfer(cmd); // WREN write enable
  res = SPI.transfer(0xFF);
  spi_mem_end_trans(cs_pin);
  return res;
}

// also works as eeprom_read()
// 23A1024 SRAM
// read a block of memory into CPU memory
void sram_read(int cs_pin, uint32_t address, uint8_t *dst, uint16_t len)
{
  spi_mem_start_cmd(cs_pin, address, 0x03);
  while (len--) {
    *dst++ = SPI.transfer(0xFF);
  }
  spi_mem_end_trans(cs_pin);
}
#define eeprom_read sram_read

// write CPU memory out to SPI SRAM memory 
void sram_write(int cs_pin, uint32_t address, const uint8_t *src, uint16_t len)
{
  spi_mem_start_cmd(cs_pin, address, 0x02);
  while (len--) {
    SPI.transfer(*src++);
  }
  spi_mem_end_trans(cs_pin);
}

// 23CSM01 EEPROM
// Wait for Write-in-progress
void eeprom_wait_wip(int cs_pin)
{
  // wait while writing
  uint8_t status;
  do {
    status = spi_mem_single_cmd(cs_pin, 0x05); // RDSR read status reg
  } while (status & 1);
}

// Write from CPU memory to EEPROM memory
// Note: You cannot cross page boundaries on my 23CSM01 it's 256 byte pages but on
// other EEPROMs it could be smaller (64, 128 bytes, etc...)
void eeprom_write(int cs_pin, uint32_t address, const uint8_t *src, uint16_t len)
{
  // make sure there isn't a write in progress
  eeprom_wait_wip(cs_pin);

  // enable write latch
  spi_mem_single_pulse(cs_pin, 0x06); // WREN write enable

  // write buffer to EEPROM buffer (SRAM write and EEPROM write are the same command one you enable the write latch)
  sram_write(cs_pin, address, src, len);

  // wait for EEPROM to commit buffer to NV memory
  eeprom_wait_wip(cs_pin);
}

// pins on an attiny3226
#define SRAM_CS_PIN      0 // PA4
#define EEPROM_CS_PIN   13 // PC3

int mem_init(void)
{
	// clear the remapping table
	memset(mem_remaps, 0, sizeof mem_remaps);

	// set CS pins high
	pinMode(SRAM_CS_PIN, OUTPUT);
	digitalWrite(SRAM_CS_PIN, HIGH);
	
	return 0;
}

void mem_read_block(uint32_t addr, uint16_t len, uint8_t *dst)
{
	// translate address to linear address
    addr = mem_translate(addr);
    
    sram_read(SRAM_CS_PIN, addr, dst, len);
}

void mem_write_block(uint32_t addr, uint16_t len, uint8_t *src)
{
	// translate address to linear address
    addr = mem_translate(addr);
    
    sram_write(SRAM_CS_PIN, addr, src, len);
}

uint8_t mem_read_byte(uint32_t addr)
{
	uint8_t ch;
	mem_read_block(addr, 1, &ch);
	return ch;
}

uint16_t mem_read_word(uint32_t addr)
{
	uint16_t ch;
	mem_read_block(addr, 2, (uint8_t*)&ch);
	return ch;
}

void mem_write_byte(uint32_t addr, uint8_t val)
{
	mem_write_block(addr, 1, &val);
}

void mem_write_word(uint32_t addr, uint16_t val)
{
	mem_write_block(addr, 2, (uint8_t*)&val);
}

void flash_init(void)
{
	// set CS pin high as it's active low
	pinMode(EEPROM_CS_PIN, OUTPUT);
	digitalWrite(EEPROM_CS_PIN, HIGH);
}

// address of sector to erase addr[11:0] should be zero
void flash_erase_sector(uint32_t addr)
{
	// eeprom doesn't need erase 
}

// program upto page len of bytes ... (256 bytes in my case), addr[7:0] should be zero
void flash_program_page(uint32_t addr, uint8_t *src, uint16_t len)
{
	uint16_t x;
	
	// sanity check address must be page aligned
	if (addr & 0xFF) {
		return;
	}
	
	eeprom_write(EEPROM_CS_PIN, addr, src, len);
}

void flash_read_block(uint32_t addr, uint8_t *dst, uint16_t len)
{	
	eeprom_read(EEPROM_CS_PIN, addr, dst, len);
}

#endif
