/*
Small frame network code --

This small bit of code is for providing simple point to point communications
between a host and a controller over a serial like link.  It uses a standard 8 byte
payload, 8-bit addressing, 8-bit packet type, and a CRC8.  The small frame size is
meant to work well with those HC-12 devices which have a 16 byte FIFO (bursts longer
than 16 bytes can result in dropped bytes).

The protocol uses a non-streaming algorithm where at most the host sends one packet
at a time while waiting for an ack.  This is meant to enforce the small FIFO limit.
It also means that if net_send_frame() worked then your packet definitely made it 
to the other side.

When you call net_recv_frame() if it returns 0 then the 'cmd' byte is the packet command.
Values above NET_CMD_STATUS can be application defined.  At most 8 bytes can be sent or
received at a time.  What the application does with the payload is up to the application.

Since the net_send_frame() routine automatically looks for an ACK the application really only
has to call net_recv_frame() to get the response payload if any back from the application.

*/

// support functions y'all gotta provide
int net_byte_available(void);           // is a byte available to read
int net_read_byte(void);                // read byte (-1 on error)
int net_write_byte(const int x);        // write a byte (-1 on error)
unsigned long net_millis(void);         // millisecond counter

// network code

// standard command bytes
enum {
    NET_CMD_ACK=0,                    // all packets are ack'ed unless they're an ACK
    NET_CMD_NAK,                      // NAK because the packet is not valid
    NET_CMD_PING,                     // ping packet 
    NET_CMD_STATUS,                   // device specific "status" reply
    // commands after this are app specific
};

#define NET_SYNC_VALUE     0x55
#define NET_ADDR_BROADCAST 0xFF

struct net_frame {
    uint8_t
        sync,
        src_addr,
        dst_addr,
        cmd,
        payload[8],
        crc8;
};

// address of this device
uint8_t net_addr;

uint8_t net_compute_crc8(struct net_frame *f)
{
    uint8_t crc = 0;
    const uint8_t *p = (const uint8_t *)f;

    /* Process everything except crc8 */
    for (size_t i = 0; i < (sizeof(*f) - 1); i++) {
        crc ^= p[i];

        for (uint8_t bit = 0; bit < 8; bit++) {
            if (crc & 0x80) {
                crc = (crc << 1) ^ 0x07;
            } else {
                crc <<= 1;
            }
        }
    }

    return crc;
}

// check the CRC8 of a frame, 0 == correct, -1 == mismatch
int net_check_crc8(struct net_frame *f)
{
    return (net_compute_crc8(f) == f->crc8) ? 0 : -1;
}

int net_recv_frame(struct net_frame *f);

// send a frame
int net_send_frame(struct net_frame *f, uint8_t dst_addr)
{
    uint8_t *p, x;
    unsigned long tgt_ms;
    struct net_frame tf;

    f->sync     = NET_SYNC_VALUE;
    f->src_addr = net_addr;
    f->dst_addr = dst_addr;
    f->crc8     = net_compute_crc8(f);

    p = (uint8_t *)f;
    for (x = 0; x < sizeof *f; x++) {
        if (net_write_byte(p[x]) < 0) {
            return -1;
        }
    }

    // if it's not ACK/NAK or broadcast we expect an ACK
    if (dst_addr != NET_ADDR_BROADCAST && f->cmd > NET_CMD_NAK) {
        // we should get an ack back
        tgt_ms = net_millis() + 100;
        while (tgt_ms > net_millis()) {
            if (net_recv_frame(&tf) == 0) {
                if (tf.cmd == NET_CMD_ACK) {
#ifdef NET_DEBUG
                    printf("DEBUG: send() got ACK back\n");
#endif            
                    return 0;
                } else {
#ifdef NET_DEBUG
                    printf("DEBUG: send() got %02x back\n", tf.cmd);
#endif            
                    return -1;

                }
            }
        }
#ifdef NET_DEBUG
    printf("DEBUG: send() timed out waiting on ACK\n");
#endif            
        return -1;
    }
    return 0;
}

int net_send_ack(struct net_frame *f)
{
    struct net_frame tf = *f;  
    tf.cmd = NET_CMD_ACK;
    return net_send_frame(&tf, tf.src_addr);
}

int net_send_nak(struct net_frame *f)
{
    struct net_frame tf = *f;
    tf.cmd = NET_CMD_NAK;
    return net_send_frame(&tf, tf.src_addr);
}

// receive a frame, 0 on ok
int net_recv_frame(struct net_frame *f)
{
    uint8_t *p, x;
    int ch;

    p = (uint8_t *)f;

    // read sync byte
    if (net_read_byte() != NET_SYNC_VALUE) {
#ifdef NET_DEBUG
    printf("DEBUG: did not read sync byte\n");
#endif            
        return -1;
    }
    p[0] = NET_SYNC_VALUE;

    // read packet, return if timed out
    for (x = 1; x < sizeof *f; x++) {
        ch = net_read_byte();
        if (ch < 0) {
#ifdef NET_DEBUG
    printf("DEBUG: read byte is below 0, ch == %d\n", ch);
#endif            
            return ch;
        }
        p[x] = ch;
    }

    // skip if not to us (or broadcast)
    if (f->dst_addr != NET_ADDR_BROADCAST && f->dst_addr != net_addr) {
#ifdef NET_DEBUG
    printf("DEBUG: Packet is not a broadcast or addressed to us: %02x\n", f->dst_addr);
#endif            
        return -1;
    }

    // verify CRC8
    if (net_check_crc8(f) < 0) {
        if (net_addr == f->dst_addr) {
            // CRC failure transmit an NAK
            net_send_nak(f);
        }
#ifdef NET_DEBUG
    printf("DEBUG: CRC check failed got %02x exp %02x\n", f->crc8, net_compute_crc8(f));
#endif            
        return -1;
    } else {
        if (f->cmd > NET_CMD_NAK && net_addr == f->dst_addr) {
            // only ACK commands that aren't ACK/NAK and addressed to us specifically
            net_send_ack(f);
        }
    }
#ifdef NET_DEBUG
    printf("DEBUG: received packet correctly\n");
#endif            
    return 0;
}