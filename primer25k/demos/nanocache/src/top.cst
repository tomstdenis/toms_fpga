// using my ESP32 PMOD in the opposing sides PMOD port (furthest from the USB-C)
IO_LOC "uart_tx" G8;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=3.3;
IO_LOC "uart_rx" G5;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

//using the PMOD closer to the USB-C port
IO_LOC "sck_pin" C11;
IO_PORT "sck_pin" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=12 PULL_STRENGTH=STRONG BANK_VCCIO=3.3;
IO_LOC "cs_pin" B11;
IO_PORT "cs_pin" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 BANK_VCCIO=3.3;
IO_LOC "sio[3]" G10;
IO_PORT "sio[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 PULL_STRENGTH=STRONG BANK_VCCIO=3.3;
IO_LOC "sio[2]" D10;
IO_PORT "sio[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 PULL_STRENGTH=STRONG BANK_VCCIO=3.3;
IO_LOC "sio[1]" B10;
IO_PORT "sio[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 PULL_STRENGTH=STRONG BANK_VCCIO=3.3;
IO_LOC "sio[0]" C10;
IO_PORT "sio[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=4 PULL_STRENGTH=STRONG BANK_VCCIO=3.3;
IO_LOC "clk" E2;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=DOWN BANK_VCCIO=3.3;
